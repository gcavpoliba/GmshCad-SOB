+@echo off
+REM ============================================================
+REM  GmshCAD Studio - avvio con ambiente conda "gmshcad"
+REM  (nome allineato a environment.yml; sovrascrivibile con:
+REM   set GCS_ENV=altro_ambiente prima di run.bat)
+REM
+REM  ATTENZIONE: mantenere questo file in ASCII puro e con
+REM  fine-riga CRLF. Un salvataggio in UTF-8 o in LF fa dare
+REM  a cmd.exe errori tipo "... non atteso".
+REM  Il .gitattributes accluso forza gia' il CRLF al checkout.
+REM ============================================================
+setlocal enabledelayedexpansion
+
+cd /d "%~dp0"
+if "%GCS_ENV%"=="" set GCS_ENV=gmshcad
+
+REM --- Individua conda (conda-init potrebbe non essere attivo) ---
+set "CONDA_BAT="
+for %%C in ("%USERPROFILE%\miniconda3" "%USERPROFILE%\anaconda3" "%USERPROFILE%\miniforge3" "%LOCALAPPDATA%\miniconda3" "%LOCALAPPDATA%\anaconda3" "%LOCALAPPDATA%\miniforge3" "%PROGRAMDATA%\miniconda3" "%PROGRAMDATA%\anaconda3" "C:\ProgramData\miniforge3" "C:\Miniconda3" "C:\Anaconda3") do (
+    if not defined CONDA_BAT if exist "%%~C\Scripts\activate.bat" set "CONDA_BAT=%%~C\Scripts\activate.bat"
+)
+if not defined CONDA_BAT (
+    for /f "usebackq delims=" %%P in (`where conda 2^>nul`) do (
+        if not defined CONDA_BAT (
+            set "CONDA_BIN_DIR=%%~dpP"
+            REM risali da \Scripts o \condabin alla root di conda
+            for %%A in ("!CONDA_BIN_DIR!\..") do set "CONDA_ROOT=%%~fA"
+            for %%B in ("!CONDA_ROOT!\Scripts\activate.bat") do (
+                if exist "%%~fB" set "CONDA_BAT=%%~fB"
+            )
+        )
+    )
+)
+
+if defined CONDA_BAT (
+    call "%CONDA_BAT%" %GCS_ENV%
+    if errorlevel 1 echo [run.bat] ATTENZIONE: attivazione di '%GCS_ENV%' fallita. Avvio col python corrente.
+) else (
+    echo [run.bat] ATTENZIONE: conda non trovato: uso il python corrente.
+)
+
+REM --- Verifica rapida che l'interprete attivo sia quello dell'ambiente atteso ---
+python -c "import sys,os;p=sys.prefix;n=os.path.basename(p);sys.exit(0 if n=='%GCS_ENV%' else 1)" 2>nul || echo [run.bat] ATTENZIONE: python attivo NON sembra dell'ambiente '%GCS_ENV%'. Prova: conda activate %GCS_ENV% ^&^& python main.py --selfcheck
+
+python main.py %*
+endlocal
